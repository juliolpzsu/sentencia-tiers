{
  "manifest_version": 3,
  "name": "Sentencia Tiers · Consejero",
  "version": "1.3.0",
  "description": "PokéSurvivor: marca qué carta coger al subir de nivel según la build de la Sentencia de Arceus. Compatible con PokeSurvivor Plus.",
  "icons": { "128": "icon-128.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://juliolpzsu.github.io/sentencia-tiers/*"],
  "content_scripts": [
    {
      "js": ["data.js", "advisor.js"],
      "matches": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": ["bridge.js"],
      "matches": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*"],
      "run_at": "document_start"
    }
  ]
}
